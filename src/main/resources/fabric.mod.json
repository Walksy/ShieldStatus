{
	"schemaVersion": 1,
	"id": "shieldstatus",
	"version": "${version}",
	"name": "Shield Status",
	"description": "Represents shield states using colors & textures",
	"authors": [
		"Walksy"
	],
	"contact": {
		"issues": "https://github.com/Walksy/ShieldStatus/issues",
		"sources": "https://github.com/Walksy/ShieldStatus",
		"homepage": "https://discord.com/invite/zeu7uNuBWY"
	},
	"license": "MIT",
	"icon": "assets/walksy/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"walksy.shieldstatus.ShieldStatus"
		],
		"walksylib": [
			"walksy.shieldstatus.config.ShieldStatusConfig"
		]
	},
	"accessWidener": "shieldstatus.accesswidener",
	"mixins": [
		"shieldstatus.mixins.json"
	],
	"depends": {
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"walksylib": ">=2.0.0"
	}
}
